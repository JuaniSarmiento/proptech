{
	admin off

	# Logger por defecto con los registros de error del proxy (M26, D7): sin
	# log de acceso, pero un reverse_proxy que no llega a destino sí escribe
	# un registro de error, y ese registro incluye el pedido entero. Se
	# filtran la URI (con su query string) y los encabezados.
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

{$PROPTECH_SITIO} {
	# Pisa siempre el X-Request-ID que mande el cliente (D8): un valor
	# elegido por el cliente serviría para ensuciar los logs o hacerse
	# pasar por otro pedido.
	request_header X-Request-ID {http.request.uuid}

	handle /api/salud {
		reverse_proxy api:8000
	}

	# D4/RA2b-1: este 404 nace acá, sin tocar Next ni FastAPI.
	handle /api/* {
		header X-Proptech-Origen caddy
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	# D1/D-051: cuatro cabeceras de seguridad, y Server/Via/X-Powered-By
	# quitadas (también lo que viene de atrás: Caddy mismo agrega Via, y
	# Next.js agrega X-Powered-By salvo que se le pida lo contrario,
	# `next.config.ts`). `header_down` aplica a la respuesta de arriba
	# (api/web) en cada `reverse_proxy`, así que un `header` al nivel del
	# sitio alcanza a los dos `handle` por igual, sin duplicarlo en cada
	# uno.
	header {
		-Server
		-Via
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	# El que necesite correlacionar del lado del cliente lee el de la
	# respuesta (D8).
	header X-Request-ID {http.request.uuid}

	# D1: `header -Server` arriba NO alcanza a un 502/504 que el propio
	# Caddy genera (p.ej. `api` caída) — es una respuesta de un camino
	# distinto dentro de Caddy, no la que armó el `header` de la ruta
	# (evidencia: un Caddyfile mínimo con `header -Server` igual devuelve
	# `Server: Caddy` en un 502). Hace falta repetir el mismo tratamiento
	# acá.
	handle_errors {
		header {
			-Server
			-Via
			-X-Powered-By
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
		}
	}
}

# C2-2 (rompedor/auditor, vuelta 1 del 2c): sitio de respaldo. Un pedido
# que no matchea el host de {$PROPTECH_SITIO} (por IP, con un Host ajeno,
# o sin Host en HTTP/1.0) caía en la respuesta POR DEFECTO de Caddy — un
# 200 vacío armado por fuera del bloque del sitio, así que ni el `header`
# de arriba ni `handle_errors` lo alcanzan: salía con Server: Caddy y sin
# ninguna cabecera de seguridad. Este bloque, sin host (cualquier Host en
# el puerto 80), es lo último que Caddy prueba, así que nunca compite con
# el sitio real. No cubre lo que Caddy arma ANTES de elegir un sitio (una
# línea de pedido mal formada, un encabezado gigante, HTTP/9.9): eso es la
# excepción documentada en la spec, inherente al servidor HTTP de Go.
:80 {
	header {
		-Server
		-Via
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	respond 421
}
