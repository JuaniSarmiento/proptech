# Copiar a infra/.env y completar. Nunca commitear infra/.env (ver .gitignore).
# Ninguno de estos valores es un secreto real.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=proptech

# Cuatro roles, cuatro contraseñas (D1, D3, cambio 2a): el de arranque
# (superusuario de la imagen, sólo lo tienen `db` y `migraciones`) y los tres
# que crea y repara `roles.py` antes de que corra Alembic. Los tres nombres
# siguen el patrón proptech_<algo>; la tabla completa de variables es del
# cambio 2c.
# Vuelta 2, R8: las cuatro contraseñas tienen que ser DISTINTAS entre sí
# (`roles antes` rechaza el arranque si dos coinciden, sin mostrar valores) —
# las cuatro iguales era justo el ejemplo que traía este archivo antes, y
# copiarlo sin editar es el camino por defecto a que la API terminara
# conectada con la contraseña del superusuario.
POSTGRES_USER=proptech
POSTGRES_PASSWORD=cambiar-este-valor-en-local-arranque
POSTGRES_MIGRADOR_USER=proptech_migrador
POSTGRES_MIGRADOR_PASSWORD=cambiar-este-valor-en-local-migrador
POSTGRES_APP_USER=proptech_app
POSTGRES_APP_PASSWORD=cambiar-este-valor-en-local-app
POSTGRES_RESPALDO_USER=proptech_respaldo
POSTGRES_RESPALDO_PASSWORD=cambiar-este-valor-en-local-respaldo

# Redis llega en el cambio `cola-logs-y-respaldos`; la API ya valida la forma
# de estas variables aunque todavía no haya nadie del otro lado (D11).
REDIS_PASSWORD=cambiar-este-valor-en-local

# Dirección del sitio que sirve Caddy. En local, http:// evita certificados
# autofirmados. En producción es el dominio real (Caddy saca el certificado solo).
PROPTECH_SITIO=http://localhost

# SÓLO DESARROLLO. Nunca en producción. Habilita el comando que carga el
# edificio de ejemplo (`python -m proptech_core.complejos.aplicacion.ejemplo
# cargar`): sin este valor exacto el comando sale con error y no escribe nada
# (guarda de entorno, D-112). Compose no la pasa a ningún servicio; se
# da sólo al correr ese comando, por ejemplo
# `docker compose exec -e PROPTECH_ENTORNO=desarrollo api python -m ...`.
# PROPTECH_ENTORNO=desarrollo

# Respaldos (D9, cambio 1d). La carpeta es del HOST (bind mount, fuera de
# git); crearla antes del primer `docker compose up`. UID/GID son los del
# usuario del host (`id -u` / `id -g`), para que los archivos no queden de
# un uid que el host no conoce.
PROPTECH_DIR_RESPALDOS=./datos-respaldos
PROPTECH_UID=1000
PROPTECH_GID=1000
RESPALDO_INTERVALO_SEGUNDOS=86400
RESPALDO_CONSERVAR=14
RESPALDO_LIMITE_SEGUNDOS=1800

# Login e invitaciones (D1/D6): Juani carga los valores sólo en su entorno.
# Sin CLERK_JWT_KEY el login queda apagado. Dejar estas líneas comentadas
# hasta configurarlas: ausente y vacío son distintos; un PEM vacío se rechaza.
# CLERK_JWT_KEY=
# CLERK_PARTES_AUTORIZADAS=
# CLERK_EMISOR=
# CLERK_SECRET_KEY=
# E16: la requieren worker (invitaciones) y servidor de Next, nunca API/navegador.
# El humo usa su propia clave ficticia en compose.humo.yaml; no cargarla acá.
# INVITACIONES_CLAVE_CIFRADO=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# PROPTECH_URL_PUBLICA=
