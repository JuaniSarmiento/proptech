# Copiar a infra/.env y completar. Nunca commitear infra/.env (ver .gitignore).
# Ninguno de estos valores es un secreto real.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=proptech
POSTGRES_PASSWORD=cambiar-este-valor-en-local
POSTGRES_DB=proptech

# Redis llega en el cambio `cola-logs-y-respaldos`; la API ya valida la forma
# de estas variables aunque todavía no haya nadie del otro lado (D11).
REDIS_PASSWORD=cambiar-este-valor-en-local

# Dirección del sitio que sirve Caddy. En local, http:// evita certificados
# autofirmados. En producción es el dominio real (Caddy saca el certificado solo).
PROPTECH_SITIO=http://localhost
